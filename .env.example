# Copy to .env to override the defaults used by docker-compose.yml.
DB_NAME=league
DB_USER=league
DB_PASSWORD=league
DB_PORT=5432

# Backend profiles: dev = name-only test login; add google and/or discord when credentials are set.
SPRING_PROFILES_ACTIVE=dev
# Google: https://console.cloud.google.com/apis/credentials  (redirect URI: http://localhost:3000/login/oauth2/code/google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Discord: https://discord.com/developers/applications  (redirect URI: http://localhost:3000/login/oauth2/code/discord)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Public address of the app, used for links in Discord posts.
APP_PUBLIC_URL=http://localhost:3000

# Screenshot storage (any S3-compatible service). Defaults use the storage container in docker-compose.yml.
STORAGE_ENDPOINT=
STORAGE_REGION=us-east-1
STORAGE_BUCKET=league-uploads
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
